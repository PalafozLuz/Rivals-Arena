            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "acao"
                ],
                "additionalProperties": false,
                "properties": {
                  "acao": {
                    "type": "string",
                    "enum": [
                      "convidar",
                      "aceitar",
                      "recusar",
                      "sair",
                      "remover",
                      "transferir"
                    ]
                  },
                  "username": {
                    "type": "string",
                    "description": "Nome exato do jogador a convidar"
                  },
                  "id_jogador": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Membro para remover ou promover"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ação concluída"
          },
          "400": {
            "description": "Ação ou estado inválido"
          },
          "403": {
            "description": "Sem permissão"
          }
        }
      }
    },
